# Copy this file to .env.local (never commit .env.local) and fill in what you have.
# Everything is optional for local development. See README.md for details.

# --- Site ---------------------------------------------------------------
# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- WhatsApp / social / map -------------------------------------------
# Optional override. Defaults to CEST's confirmed number (+232 78 865887).
# International format, digits only, no "+": e.g. 23278865887
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_LINKEDIN_URL=
# Google Maps: Share > Embed a map > copy the src="..." URL
NEXT_PUBLIC_MAP_EMBED_URL=

# --- Form delivery (server-side only: never prefix with NEXT_PUBLIC_) ----
# Option 1: email via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=cestmasingbi2018@gmail.com
# Must be a sender verified in Resend, e.g. "CEST Website <noreply@yourdomain.org>"
CONTACT_FROM_EMAIL=

# Option 2: save to Supabase table "form_submissions" (see README for the SQL)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Testing only: accept form submissions without delivering them anywhere.
# Never set this in production.
FORMS_LOG_ONLY=

# --- Admin placeholder (/admin) -------------------------------------------
# /admin returns 404 unless BOTH are set. Use a long random password.
ADMIN_USER=
ADMIN_PASSWORD=
